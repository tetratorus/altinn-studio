# Optional overrides for the local reporting runtime. Everything has a dev-only default in
# scripts/lib.sh / docker-compose.yml; copy to .env to change. None of these are real secrets.
LRR_PFX_PASSWORD=lrr-dev-only
LRR_MOCKPORTEN_PASSWORD=lrr-synthetic-only
LRR_MOCKPORTEN_CLIENT_SECRET=lrr-dev-only-client-secret
LRR_OIDC_PEPPER=lrr-dev-only-pepper-not-a-secret
# LRR_BUILD=1   # make up.sh (re)build the lrr/*:local images first
